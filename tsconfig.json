{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.cjs", "src/**/*.js", "src/**/*.d.ts", "scripts/**/*.cjs"],
  "exclude": ["src/main.cjs", "src/preload.cjs"]
}
