{
  "name": "mecode-desktop",
  "productName": "MeCode",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first MeCode prototype with default-off experimental packaged-Linux Run; Submit unavailable",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs ../prototypes/trusted-workspace/test_run_ui_contract.cjs",
    "stage": "node stage.cjs",
    "start": "npm run stage && electron .",
    "package": "npm run stage && electron-forge package",
    "make": "npm run stage && electron-forge make"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "electron": "44.7.2"
  }
}
