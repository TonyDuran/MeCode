{
  "name": "mecode-v2",
  "version": "0.0.3-t11",
  "private": true,
  "description": "MeCode V2 vertical slice: local web app + containerized runner (optional Electron wrapper)",
  "main": "src/main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node src/web/server.cjs",
    "test": "node --test \"tests/unit/*.test.cjs\"",
    "test:integration": "node --test --test-concurrency=1 tests/integration/docker.test.cjs",
    "test:e2e": "node --test tests/e2e/gui.test.cjs",
    "test:canary": "node tests/canary/run-canaries.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:toolchain": "node scripts/verify-toolchain.cjs",
    "package:web": "node scripts/package-web.cjs",
    "package:platforms": "node scripts/package-platforms.cjs",
    "verify:archives": "node scripts/verify-archives.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright-core": "1.58.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  }
}
